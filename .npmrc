# @deepseek-ai/* are provided by the DSH runtime; link them from the host checkout for type resolution.
auto-install-peers=false
strict-peer-dependencies=false

#
# ⚠️ 2026-09-26 实测更正（pnpm 11.7.0）：本文件里的 auto-install-peers / autoInstallPeers /
#    legacy-peer-deps **都不会阻止 pnpm 11 把 peerDependencies 装成真实副本**
#    （.npmrc 的两种键名写法均已实测无效，反值对照已复核）。
#    真正生效的位置是同目录 pnpm-workspace.yaml 里的 `autoInstallPeers: false`。
#    实验矩阵见 E:////alice////reports////dsh-升级-0.1.7-rc.2-2026-09-26.md 第 4.2 节。
